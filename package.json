{
  "name": "pepkio-matched-null-gene-set-generator",
  "version": "0.1.0",
  "description": "Generate confound-matched random gene sets as negative controls for GSEA, fgsea, and clusterProfiler with balance metrics and GMT export via the Pepkio Tools REST API.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-matched-null-gene-set-generator": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-matched-null-gene-set-generator-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-matched-null-gene-set-generator-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/matched-null-gene-set-generator",
  "keywords": [
    "matched-null-gene-set-generator",
    "genomics",
    "enrichment",
    "null",
    "gsea",
    "fgsea",
    "clusterprofiler",
    "gene-sets",
    "negative-control",
    "covariate-matching",
    "bioinformatics",
    "pepkio",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
